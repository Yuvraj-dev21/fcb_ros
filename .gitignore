# colcon workspace build artifacts -- never commit these, they are
# machine-specific (baked-in paths, architecture, compiler flags) and are
# regenerated by `colcon build` on any machine that clones this repo.
build/
install/
log/

# third-party dependencies cloned next to the driver (see README) --
# fetch your own copy, don't vendor them into this repo
/ffmpeg_encoder_decoder/
/ffmpeg_image_transport/
/ffmpeg_image_transport_msgs/

# editor / OS noise
*.swp
*.swo
*~
.DS_Store
__pycache__/
*.pyc
